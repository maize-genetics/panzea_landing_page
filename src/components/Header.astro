---
import PanzeaLogo from '../assets/brand/panzea.svg';
import nav from '../data/nav.json';
import { isCurrent, isExternal, url } from '../lib/url';

const pathname = Astro.url.pathname;

type NavItem = { label: string; href: string; children?: NavItem[] };
const items = nav as NavItem[];

const active = (item: NavItem) =>
  isCurrent(item.href, pathname) ||
  (item.children ?? []).some((c) => isCurrent(c.href, pathname));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label="Panzea home">
      <PanzeaLogo class="logo" aria-hidden="true" />
      <span class="wordmark"><span class="pan">pan</span><span class="zea">zea</span></span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="bars" aria-hidden="true"></span>
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="level-1">
        {
          items.map((item) => (
            <li class={item.children ? 'has-children' : undefined}>
              <div class="row">
                <a
                  href={url(item.href)}
                  aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}
                  class:list={['top-link', { active: active(item) }]}
                >
                  {item.label}
                </a>
                {item.children && (
                  <button
                    class="submenu-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-label={`Show ${item.label} pages`}
                    data-submenu-toggle
                  >
                    <span aria-hidden="true">▾</span>
                  </button>
                )}
              </div>
              {item.children && (
                <ul class="level-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={url(child.href)}
                        aria-current={isCurrent(child.href, pathname) ? 'page' : undefined}
                        rel={isExternal(child.href) ? 'noopener' : undefined}
                      >
                        {child.label}
                        {isExternal(child.href) && (
                          <span class="ext" aria-hidden="true">
                            ↗
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  header?.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const li = button.closest('li');
      const open = li?.classList.toggle('expanded') ?? false;
      button.setAttribute('aria-expanded', String(open));
    });
  });

  // Close the mobile menu after following a link or pressing Escape.
  header?.addEventListener('keydown', (event) => {
    if ((event as KeyboardEvent).key !== 'Escape') return;
    header.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.focus();
  });
</script>

<style>
  .site-header {
    background: linear-gradient(180deg, var(--gold-200), var(--gold-300));
    border-bottom: 3px solid var(--gold-500);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    margin-right: auto;
  }

  .brand :global(.logo) {
    height: 1.875rem;
    width: auto;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--green-600);
    letter-spacing: 0.01em;
  }

  .pan {
    font-weight: 700;
  }

  .zea {
    font-style: italic;
    font-weight: 400;
    font-synthesis-weight: none;
  }

  .brand:hover .wordmark {
    color: var(--green-700);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.55rem;
    font: inherit;
    font-weight: 600;
    color: var(--brown-700);
    background: rgb(255 255 255 / 60%);
    border: 1px solid var(--gold-500);
    border-radius: var(--radius);
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before {
    top: -6px;
  }

  .bars::after {
    top: 6px;
  }

  .level-1,
  .level-2 {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .level-1 {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 58%), rgb(255 255 255 / 0%) 60%),
      #ffe9bf;
    border-radius: 3px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 60%);
  }

  .level-1 > li {
    position: relative;
  }

  .level-1 > li + li {
    border-left: 1px solid var(--gold-500);
  }

  .row {
    display: flex;
    align-items: center;
  }

  .site-nav a {
    display: block;
    padding: 0.55rem 0.7rem;
    color: var(--brown-700);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background: rgb(255 255 255 / 70%);
    color: var(--green-700);
  }

  .site-nav .top-link {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    line-height: 2.8rem;
    padding: 0 1.1rem;
    color: var(--gold-500);
    border-radius: 0;
    transition: color 0.4s ease;
  }

  .site-nav .top-link:hover,
  .site-nav .top-link:focus-visible,
  .site-nav .top-link.active {
    background: none;
    color: #094c09;
  }

  /* On desktop the submenus open on hover, so the toggle is mobile-only. */
  .submenu-toggle {
    display: none;
    font: inherit;
    line-height: 1;
    color: var(--brown-700);
    background: none;
    border: 0;
    border-radius: var(--radius);
    padding: 0.55rem 0.7rem;
    cursor: pointer;
  }

  .level-2 {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 15rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
    padding: 0.35rem;
    display: none;
  }

  .has-children:hover > .level-2,
  .has-children:focus-within > .level-2 {
    display: block;
  }

  .level-2 a {
    font-weight: 500;
    white-space: nowrap;
  }

  .ext {
    font-size: 0.8em;
    opacity: 0.6;
    margin-left: 0.25rem;
  }

  @media (max-width: 62rem) {
    .menu-toggle {
      display: inline-flex;
    }

    .submenu-toggle {
      display: block;
      margin-left: auto;
    }

    .site-nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: 1rem;
    }

    .site-header.open .site-nav {
      display: block;
    }

    .level-1 {
      display: block;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: none;
      padding: 0.4rem;
    }

    .level-1 > li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .row > .top-link {
      flex: 1;
    }

    .site-nav .top-link {
      line-height: 2.4rem;
      padding: 0 0.7rem;
      color: var(--brown-700);
    }

    .level-2 {
      position: static;
      display: none;
      border: 0;
      box-shadow: none;
      padding: 0 0 0.5rem 0.9rem;
      border-left: 2px solid var(--gold-300);
      margin: 0 0 0.25rem 0.8rem;
      min-width: 0;
    }

    .has-children:hover > .level-2 {
      display: none;
    }

    .has-children.expanded > .level-2 {
      display: block;
    }

    .has-children.expanded .submenu-toggle span {
      display: inline-block;
      transform: rotate(180deg);
    }

    .level-2 a {
      white-space: normal;
    }
  }
</style>
