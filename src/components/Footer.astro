---

<footer class="site-footer">
  <div class="wrap">
    <div class="notes">
      {site.footerNotes.map((note) => <div class="note" set:html={md(note)} />)}
    </div>

    <div class="colophon">
      <div class="copyright">
        <div class="highlight">
          &copy; {new Date().getFullYear()}{' '}
          <a href="https://www.maizegenetics.net"><b>Lab for Plant Genomic Diversity &amp; Design</b></a>
        </div>
      </div>

      <ul class="social">
        {
          socialLinks.map((s) => (
            <li>
              <a href={s.href} rel="noopener" title={s.label} aria-label={s.label}>
                <svg viewBox={s.viewBox} aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--brown-900);
    color: #e9e2d0;
    padding: 2.5rem 0 2rem;
    font-size: 0.925rem;
  }

  /* :global reaches the links inside the Markdown-rendered footer notes. */
  .site-footer :global(a) {
    color: #f3dba3;
  }

  .site-footer :global(a:hover) {
    color: #fff;
  }

  .notes {
    display: grid;
    gap: 1rem;
    max-width: 80ch;
  }

  .note :global(p) {
    margin: 0;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(243 219 163 / 25%);
    font-size: 0.88rem;
    line-height: 1.6;
    color: #fff;
  }

  .highlight,
  .site-footer .colophon a {
    color: rgb(255 255 255 / 70%);
    text-decoration: none;
  }

  .site-footer .colophon a:hover {
    color: #fff;
  }

  .social {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
  }

  .social svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
</style>
