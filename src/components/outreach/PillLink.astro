---
import { isExternal, url } from '../../lib/url';

interface Props {
  href: string;
  variant?: 'solid' | 'soft';
}

const { href, variant = 'soft' } = Astro.props;
const external = isExternal(href);
---

<a class:list={['pill', variant]} href={url(href)} rel={external ? 'noopener' : undefined}>
  <slot />
  <span aria-hidden="true">{external ? '↗' : href.startsWith('mailto:') ? '✉' : '→'}</span>
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .solid {
    color: #fff;
    background: var(--green-700);
    border-color: var(--green-700);
  }

  .solid:hover {
    color: #fff;
    background: var(--green-600);
    border-color: var(--green-600);
  }

  .soft {
    color: var(--green-700);
    background: var(--surface);
    border-color: var(--gold-300);
  }

  .soft:hover {
    color: var(--brown-700);
    border-color: var(--gold-500);
  }
</style>
