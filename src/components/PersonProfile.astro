---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { mdInline } from '../lib/markdown';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { name, role, affiliation, location, email, photo, contact } = person.data;
const { Content } = await render(person);
const hasAside = Boolean(photo || contact.length || email);
---

<div class:list={['profile', { 'with-aside': hasAside }]}>
  {
    hasAside && (
      <aside class="sidebar">
        {photo && (
          <Image
            class="portrait"
            src={photo}
            alt={`Portrait of ${name}`}
            widths={[320, 640]}
            sizes="(min-width: 55rem) 18rem, 60vw"
            loading="eager"
          />
        )}
        {(contact.length > 0 || email) && (
          <div class="contact">
            <h2>Contact</h2>
            <address>
              {contact.map((line) => (
                <span set:html={mdInline(line)} />
              ))}
              {email && (
                <span>
                  <a href={`mailto:${email}`}>{email}</a>
                </span>
              )}
            </address>
          </div>
        )}
      </aside>
    )
  }

  <div class="main">
    <p class="role">{role}</p>
    {
      (affiliation.length > 0 || location) && (
        <p class="affiliation">
          {[...affiliation, location].filter(Boolean).join(' · ')}
        </p>
      )
    }
    <div class="prose"><Content /></div>
  </div>
</div>

<style>
  .profile {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  @media (min-width: 55rem) {
    .profile.with-aside {
      grid-template-columns: 17rem minmax(0, 1fr);
      align-items: start;
    }
  }

  .sidebar {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .portrait {
    width: 100%;
    max-width: 17rem;
    height: auto;
    border-radius: var(--radius);
    border: 4px solid #fff;
    box-shadow: var(--shadow-lift);
    background: var(--gold-100);
  }

  .contact h2 {
    font-size: var(--step-1);
    margin: 0 0 0.35rem;
  }

  address {
    font-style: normal;
    display: grid;
    gap: 0.15rem;
    color: var(--ink-muted);
    font-size: 0.93rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .role {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--green-700);
  }

  .affiliation {
    margin: 0.2rem 0 1.5rem;
    color: var(--ink-muted);
  }

  .role:empty,
  .affiliation:empty {
    display: none;
  }
</style>
