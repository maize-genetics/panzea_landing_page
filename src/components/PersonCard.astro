---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const { name, role, affiliation, location, photo } = person.data;
const href = url(`/${person.id}`);
---

<li class="card">
  {
    photo && (
      <a class="photo" href={href} tabindex="-1" aria-hidden="true">
        <Image src={photo} alt="" widths={[220, 440]} sizes="220px" />
      </a>
    )
  }
  <div class="body">
    <h3><a href={href}>{name}</a></h3>
    {role && <p class="role">{role}</p>}
    {affiliation.map((line) => <p class="meta">{line}</p>)}
    {location && <p class="meta">{location}</p>}
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .card:has(a:hover),
  .card:has(a:focus-visible) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .photo {
    display: block;
    background: var(--gold-100);
  }

  /* The aspect ratio lives on the image itself: on the wrapper the image's
     intrinsic height would win and cards would end up different heights. */
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .body {
    padding: 0.9rem 1rem 1.1rem;
  }

  h3 {
    font-size: var(--step-1);
    margin: 0 0 0.25rem;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .role {
    margin: 0 0 0.35rem;
    font-weight: 600;
    color: var(--green-700);
    font-size: 0.925rem;
  }

  .meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }
</style>
