---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { md } from '../lib/markdown';
import { url } from '../lib/url';

const terms = (await getCollection('glossary')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Glossary"
  description="Definitions of the genetics terms used across the Panzea maize diversity project."
>
  <nav class="index" aria-label="Terms">
    <ul>
      {
        terms.map((t) => (
          <li>
            <a href={`#${t.data.id}`}>{t.data.term}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <dl>
    {
      terms.map((t) => (
        <div class="entry">
          <dt id={t.data.id}>{t.data.term}</dt>
          <dd class="prose" set:html={md(t.data.definition)} />
        </div>
      ))
    }
  </dl>

  <p class="more">
    See also the <a href={url('/faqs')}>frequently asked questions</a>.
  </p>
</BaseLayout>

<style>
  .index ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 2.5rem;
  }

  .index a {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .index a:hover {
    background: var(--gold-100);
    border-color: var(--gold-500);
  }

  dl {
    margin: 0;
  }

  .entry {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  dt {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--brown-700);
    scroll-margin-top: 6rem;
    margin-bottom: 0.35rem;
  }

  dd {
    margin: 0;
  }

  .more {
    margin-top: 1.5rem;
  }
</style>
