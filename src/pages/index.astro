---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import CardGrid from '../components/CardGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);
const { tagline, description, hero, cards } = home.data;
---

<BaseLayout title={site.title} description={description} bare>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-text">
        <h1>{tagline}</h1>
        <div class="prose"><Content /></div>
      </div>
      {
        hero && (
          <Image
            class="hero-img"
            src={hero}
            alt="Maize ears ripening on the plant in a research field"
            widths={[640, 1000]}
            sizes="(min-width: 60rem) 34rem, 100vw"
            loading="eager"
          />
        )
      }
    </div>
  </section>

  <div class="wrap section">
    <h2 class="visually-hidden">Explore Panzea</h2>
    <CardGrid cards={cards} />
  </div>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--sand-200), var(--gold-100));
    border-bottom: 1px solid var(--border);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 60rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }

  .hero-text h1 {
    margin-top: 0;
  }

  .hero-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 4px solid #fff;
    box-shadow: var(--shadow-lift);
  }

  .section {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
</style>
