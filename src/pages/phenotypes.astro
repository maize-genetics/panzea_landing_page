---
import { Image } from 'astro:assets';
import DatasetGroup, { type Dataset } from '../components/DatasetGroup.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/phenotypes.json';
import { url } from '../lib/url';
import cornEar from '../assets/phenotypes/CornEarRuler.png';

// Content mirrors the Cornell file gateway the old page embedded in an iframe.
const datasets = data.datasets as Dataset[];
const totalFiles = datasets.reduce((n, d) => n + (d.files?.length ?? 0), 0);
---

<BaseLayout
  title="Phenotypes"
  description={`Download ${totalFiles} public maize phenotype data files from Panzea: the maize 282 and Ames association panels, the NAM population, and teosinte-maize domestication populations.`}
>
  <div class="overview">
    <Image
      class="figure"
      src={cornEar}
      alt="Maize ear measured against a ruler"
      widths={[cornEar.width]}
    />
    <div>
      <p class="lede">
        Download the latest public &ldquo;flat file&rdquo; versions of prepackaged phenotypic data
        sets.
      </p>
      <p>
        This project has collected and released phenotypic data for numerous agronomic,
        developmental, and domestication-related traits collected in the maize 282 or Ames inbred
        association panels, the NAM population, or custom teosinte-maize populations.
      </p>
    </div>
  </div>

  <nav class="jump" aria-label="Jump to data set">
    <ul>
      {
        datasets.map((d) => (
          <li>
            <a href={`#${d.id}`}>
              {d.title.replace(/ phenotypes.*$/i, '')}
              <span class="count">{d.files?.length ?? 0}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {datasets.map((d) => <DatasetGroup dataset={d} />)}

  <p class="tip">
    If a download link doesn't open, try right-clicking it and opening it in a new tab. Looking for
    other data? See <a href={url('/genotypes')}>Genotypes</a> and{' '}
    <a href={url('/gwas-results')}>GWAS results</a>.
  </p>
</BaseLayout>

<style>
  .overview {
    display: grid;
    gap: 1.25rem 1.75rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 48rem) {
    .overview {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }

  .overview :global(.figure) {
    display: block;
    width: 100%;
    max-width: 14rem;
    height: auto;
    padding: 0.75rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .overview > div {
    max-width: var(--measure);
  }

  .lede {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }

  .jump ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 2.5rem;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.5rem 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .jump a:hover {
    background: var(--gold-100);
    border-color: var(--gold-500);
  }

  .count {
    min-width: 1.5rem;
    padding: 0 0.4rem;
    font-size: 0.78rem;
    text-align: center;
    color: #fff;
    background: var(--green-700);
    border-radius: 999px;
  }

  .tip {
    max-width: var(--measure);
    font-size: 0.92rem;
    color: var(--ink-muted);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
</style>
