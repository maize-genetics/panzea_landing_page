---
import { getCollection } from 'astro:content';
import PublicationEntry from '../components/PublicationEntry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const UP_TO = 2008;

const years = (await getCollection('publications'))
  .filter((y) => y.data.year <= UP_TO)
  .sort((a, b) => b.data.year - a.data.year);

const total = years.reduce((n, y) => n + y.data.entries.length, 0);
---

<BaseLayout
  title="Publications: 2008 and earlier"
  description={`${total} publications from the Panzea maize diversity project up to 2008.`}
>
  <p class="lede">
    {total} publications up to {UP_TO}. For later work see{' '}
    <a href={url('/publications')}>Publications from 2009 onwards</a>.
  </p>

  <nav class="jump" aria-label="Jump to year">
    <ul>
      {
        years.map((y) => (
          <li>
            <a href={`#${y.data.year}`}>{y.data.year}</a>
          </li>
        ))
      }
      <li><a href={url('/publications')}>2009 to current</a></li>
    </ul>
  </nav>

  {
    years.map((y) => (
      <section class="year">
        <h2 id={y.data.year.toString()}>{y.data.year}</h2>
        <ol class="entries">
          {y.data.entries.map((entry) => (
            <PublicationEntry entry={entry} />
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>

<style>
  .lede {
    max-width: var(--measure);
  }

  .jump ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 2rem;
  }

  .jump a {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .jump a:hover {
    background: var(--gold-100);
    border-color: var(--gold-500);
  }

  .year {
    margin-bottom: 2.5rem;
  }

  .year h2 {
    scroll-margin-top: 6rem;
    padding-bottom: 0.3rem;
    border-bottom: 3px solid var(--gold-300);
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
