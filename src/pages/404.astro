---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const suggestions = [
  { label: 'Home', href: '/' },
  { label: 'Data', href: '/data' },
  { label: 'Publications', href: '/publications' },
  { label: 'People', href: '/allpeople' },
  { label: 'Education and Outreach', href: '/education-and-outreach' },
  { label: 'Contact Us', href: '/contact-us' },
];
---

<BaseLayout title="Page not found" description="The page you asked for does not exist.">
  <p class="lede">
    We could not find that page. It may have moved when the site was rebuilt in 2026.
  </p>
  <ul>
    {
      suggestions.map((s) => (
        <li>
          <a href={url(s.href)}>{s.label}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
