---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const MEMBERS: { person: string; group?: { label: string; href: string } }[] = [
  { person: 'edward-buckler', group: { label: 'Buckler Lab', href: 'http://www.maizegenetics.net/' } },
  { person: 'john-doebley', group: { label: 'Doebley Lab', href: 'http://teosinte.wisc.edu/' } },
  { person: 'jeff-ross-ibarra', group: { label: 'Ross-Ibarra Lab', href: 'http://www.rilab.org/' } },
  { person: 'doreen-ware', group: { label: 'Ware Lab', href: 'http://www.warelab.org/' } },
  {
    person: 'jim-holland',
    group: { label: 'Holland Lab', href: 'http://www4.ncsu.edu/~jholland/homepage.htm' },
  },
  {
    person: 'sherry-flint-garcia',
    group: { label: 'Flint-Garcia Lab', href: 'http://web.missouri.edu/~flint-garcias/home.html' },
  },
  {
    person: 'qi-sun',
    group: {
      label: 'Bioinformatics Facility',
      href: 'http://www.biotech.cornell.edu/brc/bioinformatics-facility',
    },
  },
  {
    person: 'sharon-mitchell',
    group: {
      label: 'Genomic Diversity Facility',
      href: 'http://www.biotech.cornell.edu/brc/genomic-diversity-facility',
    },
  },
  { person: 'peter-bradbury' },
  { person: 'theresa-fulton' },
];

const members = await Promise.all(
  MEMBERS.map(async ({ person, group }) => {
    const entry = await getEntry('people', person);
    if (!entry) throw new Error(`current-project: no person entry "${person}"`);
    return { entry, group };
  }),
);
---

<BaseLayout
  title="Current Project"
  description="The NSF-funded Panzea project on the biology of rare alleles in maize and its wild relatives: funding, member labs, and collaborators."
>
  <p class="lede">
    This project improved our understanding of the genetic architecture &mdash; the connection
    between phenotype (what we see) and genotype (the genes underlying the phenotype) &mdash; of
    complex traits in maize and its wild relative, teosinte.
  </p>
  <p class="intro">
    Understanding variation in genetic architecture is key to understanding evolution,
    manipulating species for a sustainable agriculture, and preserving variation as species
    adapt.
  </p>

  <section class="award" aria-labelledby="award-heading">
    <p class="eyebrow">NSF Plant Genome Research Project &middot; Award #1238014</p>
    <h2 id="award-heading">The Biology of Rare Alleles in Maize and Its Wild Relatives</h2>
    <p>The Panzea project was funded by the National Science Foundation.</p>
    <a class="pill" href="http://www.nsf.gov/awardsearch/showAward?AWD_ID=1238014" rel="noopener">
      View the NSF award <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section aria-labelledby="members-heading">
    <div class="section-head">
      <h2 id="members-heading">Project members</h2>
      <a href={url('/allpeople')}>See everyone on the project <span aria-hidden="true">→</span></a>
    </div>
    <p class="section-lede">The project brought together these people and their labs.</p>

    <ul class="members">
      {
        members.map(({ entry, group }) => {
          const { name, affiliation, photo } = entry.data;
          return (
            <li class="member">
              {photo && (
                <Image src={photo} alt="" widths={[80, 160]} sizes="80px" class="avatar" />
              )}
              <div class="member-text">
                <h3>
                  <a href={url(`/${entry.id}`)}>{name}</a>
                </h3>
                {affiliation.map((line) => (
                  <p class="meta">{line}</p>
                ))}
                {group && (
                  <a class="group" href={group.href} rel="noopener">
                    {group.label} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  <aside class="collab">
    <p class="eyebrow">In collaboration with</p>
    <a href="http://www.priweb.org" rel="noopener">
      Paleontological Research Institution's Museum of the Earth <span aria-hidden="true">↗</span>
    </a>
  </aside>
</BaseLayout>

<style>
  .lede {
    font-size: var(--step-1);
    color: var(--ink);
    max-width: var(--measure);
    margin-bottom: 0.75rem;
  }

  .intro {
    max-width: var(--measure);
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-700);
  }

  .award {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    margin-bottom: clamp(2rem, 5vw, 3rem);
    background: linear-gradient(180deg, var(--sand-200), var(--gold-100));
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .award h2 {
    font-size: var(--step-3);
    max-width: 30ch;
  }

  .award p:not(.eyebrow) {
    margin-bottom: 1rem;
  }

  .pill {
    display: inline-block;
    padding: 0.45rem 1rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--green-700);
    background: var(--surface);
    border: 1px solid var(--gold-300);
    border-radius: 999px;
  }

  .pill:hover {
    color: var(--brown-700);
    border-color: var(--gold-500);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-bottom: 0.3rem;
    margin-bottom: 0.75rem;
    border-bottom: 3px solid var(--gold-300);
  }

  .section-head h2 {
    margin: 0;
  }

  .section-head a {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .section-lede {
    color: var(--ink-muted);
  }

  .members {
    list-style: none;
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    padding: 0;
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
  }

  .member {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .member:has(a:hover),
  .member:has(a:focus-visible) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .member :global(.avatar) {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--gold-100);
    border: 2px solid var(--gold-200);
  }

  .member h3 {
    font-size: var(--step-1);
    margin: 0.1rem 0 0.1rem;
  }

  .member h3 a {
    text-decoration: none;
  }

  .member h3 a:hover {
    text-decoration: underline;
  }

  .meta {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .group {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.15rem 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--green-700);
    background: var(--gold-100);
    border: 1px solid var(--gold-300);
    border-radius: 999px;
  }

  .group:hover {
    color: var(--brown-700);
    border-color: var(--gold-500);
  }

  .collab {
    padding: 1.1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid var(--gold-500);
    border-radius: var(--radius);
    max-width: 44rem;
  }

  .collab a {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration: none;
  }

  .collab a:hover {
    text-decoration: underline;
  }
</style>
