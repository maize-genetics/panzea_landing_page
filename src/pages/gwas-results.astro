---
import DatasetPage from '../components/DatasetPage.astro';
import type { Dataset } from '../components/DatasetGroup.astro';
import data from '../data/gwas.json';

// Content mirrors the Cornell file gateway the old page linked to.
const datasets = data.datasets as Dataset[];
---

<DatasetPage
  title="GWAS Results"
  description="Lists of SNPs and other DNA polymorphisms associated with traits in Panzea GWAS studies of the maize NAM population."
  datasets={datasets}
  related={[
    { label: 'Genotypes', href: '/genotypes' },
    { label: 'Phenotypes', href: '/phenotypes' },
  ]}
>
  <p>Obtain lists of SNPs or other DNA polymorphisms associated with traits in our GWAS studies.</p>
  <p>
    This project has performed GWAS for numerous traits in various study populations. Some of our
    results are shared here.
  </p>
</DatasetPage>
